{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ave-generator/contracts/ave-demo-recipe-1.0.0.schema.json",
  "title": "AVE Engineering Demo Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "demo_id", "title", "purpose", "duration_seconds",
    "sample_rate_hz", "fps", "audio", "visual", "verification",
    "safety", "distribution", "limitations"
  ],
  "$defs": {
    "rate_curve": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "value_hz"],
          "properties": {
            "kind": {"const": "constant"},
            "value_hz": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "start_hz", "end_hz"],
          "properties": {
            "kind": {"const": "linear"},
            "start_hz": {"type": "number", "exclusiveMinimum": 0},
            "end_hz": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      ]
    },
    "stage_common": {
      "type": "object",
      "required": ["stage_id", "start_seconds", "end_seconds", "kind"],
      "properties": {
        "stage_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0},
        "kind": {"type": "string"}
      }
    },
    "silence_stage": {
      "allOf": [
        {"$ref": "#/$defs/stage_common"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["stage_id", "start_seconds", "end_seconds", "kind"],
          "properties": {
            "stage_id": {"type": "string"},
            "start_seconds": {"type": "number"},
            "end_seconds": {"type": "number"},
            "kind": {"const": "silence"}
          }
        }
      ]
    },
    "binaural_stage": {
      "allOf": [
        {"$ref": "#/$defs/stage_common"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["stage_id", "start_seconds", "end_seconds", "kind", "left_hz", "right_hz", "amplitude"],
          "properties": {
            "stage_id": {"type": "string"},
            "start_seconds": {"type": "number"},
            "end_seconds": {"type": "number"},
            "kind": {"const": "binaural"},
            "left_hz": {"type": "number", "exclusiveMinimum": 0},
            "right_hz": {"type": "number", "exclusiveMinimum": 0},
            "amplitude": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "phase_origin_cycles": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
          }
        }
      ]
    },
    "smooth_am_stage": {
      "allOf": [
        {"$ref": "#/$defs/stage_common"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["stage_id", "start_seconds", "end_seconds", "kind", "carrier_hz", "rate", "depth", "amplitude", "envelope_shape"],
          "properties": {
            "stage_id": {"type": "string"},
            "start_seconds": {"type": "number"},
            "end_seconds": {"type": "number"},
            "kind": {"const": "smooth_am"},
            "carrier_hz": {"type": "number", "exclusiveMinimum": 0},
            "rate": {"$ref": "#/$defs/rate_curve"},
            "depth": {"type": "number", "minimum": 0, "maximum": 1},
            "amplitude": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "envelope_shape": {"const": "sine"},
            "phase_origin_cycles": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
          }
        }
      ]
    },
    "gated_pulse_stage": {
      "allOf": [
        {"$ref": "#/$defs/stage_common"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["stage_id", "start_seconds", "end_seconds", "kind", "carrier_hz", "rate", "duty_cycle", "amplitude", "edge_shape"],
          "properties": {
            "stage_id": {"type": "string"},
            "start_seconds": {"type": "number"},
            "end_seconds": {"type": "number"},
            "kind": {"const": "gated_pulse"},
            "carrier_hz": {"type": "number", "exclusiveMinimum": 0},
            "rate": {"$ref": "#/$defs/rate_curve"},
            "duty_cycle": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
            "amplitude": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "edge_shape": {"const": "hard"},
            "phase_origin_cycles": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
          }
        }
      ]
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "demo_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "sample_rate_hz": {"type": "integer", "minimum": 8000, "maximum": 192000},
    "fps": {"enum": [30, 60]},
    "audio": {
      "type": "object", "additionalProperties": false,
      "required": ["stages", "peak_linear", "master_fade_seconds", "stage_fade_seconds"],
      "properties": {
        "stages": {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/silence_stage"},
              {"$ref": "#/$defs/binaural_stage"},
              {"$ref": "#/$defs/smooth_am_stage"},
              {"$ref": "#/$defs/gated_pulse_stage"}
            ]
          }
        },
        "peak_linear": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.95},
        "master_fade_seconds": {"type": "number", "minimum": 0},
        "stage_fade_seconds": {"type": "number", "minimum": 0}
      }
    },
    "visual": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "width", "height", "cards"],
          "properties": {
            "kind": {"const": "explanatory"},
            "width": {"type": "integer", "minimum": 320},
            "height": {"type": "integer", "minimum": 320},
            "cards": {"const": ["title", "construction", "live", "verification", "boundary", "provenance"]}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "width", "height", "light_recipe_path", "light_recipe_sha256"],
          "properties": {
            "kind": {"const": "four_region"},
            "width": {"type": "integer", "minimum": 320},
            "height": {"type": "integer", "minimum": 320},
            "light_recipe_path": {"type": "string", "minLength": 1},
            "light_recipe_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_maturity", "supported_claims", "unsupported_claims", "required_fields", "tolerances"],
      "properties": {
        "evidence_maturity": {"enum": ["verified", "partially_verified", "exploratory"]},
        "supported_claims": {"type": "array", "items": {"type": "string"}},
        "unsupported_claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "required_fields": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "tolerances": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["calibrated_spl", "calibrated_luminance", "human_exposure_approved", "headphones_assumption", "warning"],
      "properties": {
        "calibrated_spl": {"const": false},
        "calibrated_luminance": {"const": false},
        "human_exposure_approved": {"const": false},
        "headphones_assumption": {"type": "string", "minLength": 1},
        "warning": {"type": "string", "minLength": 1}
      }
    },
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["media_origin", "redistributable", "license_note"],
      "properties": {
        "media_origin": {"const": "original_synthetic"},
        "redistributable": {"const": true},
        "license_note": {"type": "string", "minLength": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
